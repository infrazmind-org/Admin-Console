# Production: full URL of the FastAPI service (no trailing slash), e.g. Render.
# VITE_API_URL=https://backend-57c5.onrender.com

# Firebase Hosting: see ../docs/FIREBASE_HOSTING.md — multisite deploy from repo root. Use `.env.production` for production builds.

# Local dev: `npm run dev` serves on port 3001 (see package.json). To use another port:
#   npm run dev -- --port 5173
# Leave VITE_API_URL unset so /api is proxied (see vite.config.ts).
# VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Optional: customer app (www) for “Back to app” links on the admin sign-in page.
# VITE_PUBLIC_APP_URL=https://www.infrazmind.com

# Local UI only (no API / no login): copy this file to .env.local and uncomment:
# VITE_ADMIN_UI_PREVIEW=true

# Firebase Web SDK: copy the **admin app** block from ../docs/FIREBASE_WEB_APPS.md into `.env.local` (do not commit `.env.local`).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=